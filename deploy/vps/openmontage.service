[Unit]
Description=OpenMontage SaaS (Docker Compose production stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/opt/openmontage-saas
ExecStart=/usr/bin/docker compose --env-file /opt/openmontage-saas/.env.production -f /opt/openmontage-saas/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/openmontage-saas/.env.production -f /opt/openmontage-saas/docker-compose.prod.yml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target

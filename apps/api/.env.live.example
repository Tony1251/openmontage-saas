# === PRODUCTION (copy to .env and fill in real values) ===
# Postgres — use a managed instance (RDS / Cloud SQL / Neon / Supabase)
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/om_saas

MOCK_MODE=false

# OpenMontage MCP — deployed behind HTTPS (e.g. Fly.io / Render / VPS)
MCP_URL=https://mcp.your-domain.com/mcp
MCP_TOKEN=<from OpenMontage dashboard / tokens.json>

# Stripe — live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_ENTERPRISE=price_replace_me

# Public URLs
API_BASE_URL=https://api.your-domain.com
WEB_BASE_URL=https://your-domain.com

# Clerk — from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Redis — required for idempotency/queue in production
REDIS_URL=redis://your-redis:6379/0

# OSS / S3-compatible object storage for rendered videos
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=replace_me
OSS_ACCESS_KEY_SECRET=replace_me

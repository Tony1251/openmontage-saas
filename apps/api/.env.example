# Database
DATABASE_URL=postgresql+asyncpg://om:om@postgres:5432/om_saas

# Mode switch: true = local demo (auth + Stripe bypassed), false = real production
MOCK_MODE=false

# OpenMontage MCP (existing internal service)
MCP_URL=http://openmontage-mcp:8765/mcp
MCP_TOKEN=replace-with-mcp-token-from-tokens.json

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_pro_replace_me
STRIPE_PRICE_ENTERPRISE=price_enterprise_replace_me

# API
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Clerk (dashboard sessions)
# CLERK_PUBLISHABLE_KEY is used by the web app; CLERK_SECRET_KEY + CLERK_JWT_KEY
# are reserved for the API (JWT verification mode). Today the API authenticates
# with generated sk_live_/sk_test_ keys, so CLERK_JWT_KEY may stay blank unless
# you enable JWT verification.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=

# OSS / S3 (stubbed for now)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=openmontage-renders
OSS_ACCESS_KEY_ID=replace_me
OSS_ACCESS_KEY_SECRET=replace_me

# Clerk webhook
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Redis (for production idempotency cache; optional)
REDIS_URL=redis://redis:6379/0
